# Copy to `.env` and adjust. Every value below is the built-in default, so the
# app runs without this file on a local MariaDB/MySQL install.

# ---- API ---------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Origin allowed by CORS. The Vite dev server proxies /api, so this only
# matters when the client is served from a different origin.
CORS_ORIGIN=http://localhost:3000

# ---- Database ----------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=apex_parking
DB_POOL_SIZE=10

# Billing splits a stay on local midnight, so the process timezone decides
# where "a day" starts. Set this before any Date is constructed.
FACILITY_TZ=Africa/Johannesburg

# ---- Traffic simulator -------------------------------------------------
# Drives real check-in/check-out transactions so the dashboard has movement.
SIMULATION_ENABLED=true
# One vehicle movement every N milliseconds. The 20s default is deliberately
# calm so you can manually register a car mid-presentation. Use 2500-4000 for a
# busy rush-hour look when capturing screenshots.
SIMULATION_TICK_MS=20000
SIMULATION_PUSH_MS=2000
SIMULATION_ARRIVAL_BIAS=0.62
SIMULATION_TARGET_OCCUPANCY=0.72

# ---- Operator sign-in ---------------------------------------------------
# The single account that signs into the dashboard. Change these, and set a
# long random AUTH_SECRET, before exposing the console beyond localhost.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=apex-admin
AUTH_SECRET=apex-parking-dev-secret
# Session lifetime in milliseconds (default 12 hours).
AUTH_TOKEN_TTL_MS=43200000

# ---- Client (Vite, must be prefixed) -----------------------------------
# Only needed if the client is served from a different origin than the API;
# by default it reuses the page origin and relies on the dev proxy.
# VITE_API_TARGET=http://localhost:4000
# VITE_WS_URL=ws://localhost:4000/ws